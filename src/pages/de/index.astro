---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/sections/Navbar.astro";
import Hero from "@/components/sections/Hero.astro";
import ChooseDocs from "@/components/sections/ChooseDocs.astro";
import Community from "@/components/sections/Community.astro";
import FooterStatus from "@/components/sections/FooterStatus.astro";
---

<Layout title="SteelDocs">
  <Navbar />
  <Hero
    pillText="noch immer am Kochen"
    heroTitle="Steel"
    heroTitleHighlight="MC"
    subtitle="Minecraft in einem neuen Gewand, gebaut in Rust und mit Multithreading geplant. Wir setzen auf Vanilla like, Performance und Erweiterbarkeit"
    mainCtaText="Tritt uns bei!"
    secondCtaText="Dokumentation"
  />
  <main
    class="container mx-4 w-auto lg:mx-auto max-w-280 px-4 mt-16 lg:-mt-12 text-white relative z-10"
  >
    <ChooseDocs
      sectionLabel="WÄHLE DEINE DOKUMENATION"
      sectionTitle="Hey, was möchtest du gerne machen?"
      sectionDescription="Steel ist für jeden gedacht. Ob du Admin bist, zu dem Code contributen willst oder einfach nur das Projekt auschecken wolltest, es gibt Dokumentration für dich!"
      adminHref="./getting-started/installation/"
      adminImage="/admin.png"
      adminImageAlt="Admindokumentation"
      adminLabel="Admin"
      devHref="./development/start-contributing/"
      devImage="/contributor.png"
      devImageAlt="Contributor Dokumentation "
      devLabel="Entwickler"
    />
    <Community
      heading="Interessiert?"
      headingHighlight="Tritt uns bei!"
      descriptionBold1="Steel ist ein Ort, wo die Communtiy zusammen kommt"
      descriptionMiddle=" zum entwickeln, chatten und zusammen Spaß zu haben. Von den talentiertesten Entwicklern bis zu den größten Labertaschen "
      descriptionBold2="jeder ist willkommen!"
      descriptionAfter=" Wir sind nur eine Community, welche versucht einen geilen Minecraft server zu erstellen."
    />
    <FooterStatus
      prefix="Steel ist"
      rotatingTexts={[
        "in Entwicklung",
        "noch nicht bereit",
        "scheiß drauf, wir spielen!",
        "eine Legierung btw 🤓☝️",
        "mit liebe gemacht",
        "höllisch schnell",
        "rostig",
        "am kochen!",
        "betrunkene Typen, die 4lve feiern",
      ]}
    />
  </main>
</Layout>
